# Copy to .env and fill in. Never commit .env -- see .gitignore.
# The app refuses to boot if a required value is missing, so a
# misconfigured deploy fails at startup instead of at 3am on a checkout.

# --- required ---
DATABASE_FILE=./data/orderdesk.db
ADMIN_API_KEY=generate-a-32-char-random-string-here

# --- optional, with safe defaults ---
PORT=3002
NODE_ENV=development
LOG_LEVEL=info

# Pricing policy. Kept in configuration because finance changes these without
# a deploy; kept as integers because they are money and percentages.
TAX_BASIS_POINTS=1800
SHIPPING_FEE_MINOR=4900
FREE_SHIPPING_THRESHOLD_MINOR=40000

# Outbox worker
OUTBOX_POLL_MS=1000
OUTBOX_MAX_ATTEMPTS=5
